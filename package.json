{
  "name": "magic-patterns-vite-template",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npx vite",
    "build": "node scripts/build-prototype.mjs",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx",
    "preview": "npx vite preview",
    "start:local": "npm run build && npx vite preview --port 4173 --strictPort",
    "check:manifests": "node scripts/check-manifests.mjs",
    "typecheck:ratchet": "node scripts/typecheck-ratchet.mjs",
    "typecheck:baseline": "node scripts/typecheck-ratchet.mjs --write-baseline",
    "test:e2e": "playwright test",
    "build:realauth": "node scripts/build-realauth.mjs",
    "check:staff-console": "node scripts/check-staff-console.mjs",
    "test:e2e:flag-flip": "node scripts/test-flag-flip.mjs"
  },
  "dependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "@emotion/react": "11.14.0",
    "@radix-ui/react-icons": "1.3.2",
    "react-router-dom": "6.30.2",
    "date-fns": "4.1.0",
    "lucide-react": "0.577.0",
    "tailwind-merge": "2.6.1",
    "framer-motion": "11.18.2",
    "sonner": "1.7.1",
    "recharts": "2.15.0",
    "qrcode-generator": "1.4.4",
    "jsqr": "1.4.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "20.19.43",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@typescript-eslint/eslint-plugin": "5.62.0",
    "@typescript-eslint/parser": "5.62.0",
    "@vitejs/plugin-react": "4.7.0",
    "eslint": "8.57.1",
    "eslint-plugin-react-hooks": "4.6.2",
    "eslint-plugin-react-refresh": "0.4.26",
    "typescript": "5.9.3",
    "vite": "5.4.21",
    "tailwindcss": "3.4.17",
    "autoprefixer": "10.6.2",
    "postcss": "8.5.32"
  }
}
